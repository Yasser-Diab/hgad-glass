VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional first-run local desktop administrator. Leave unset to use the
# one-time setup button in the desktop login screen.
GLASS_ORDERS_ADMIN_USERNAME=
GLASS_ORDERS_ADMIN_PASSWORD=
GLASS_ORDERS_ADMIN_EMAIL=
GLASS_ORDERS_ADMIN_DISPLAY_NAME=

# Dedicated active Supabase Auth identity for the Telegram helper. Grant this
# profile cost-view permission; never use a service-role key in the app.
TELEGRAM_SUPABASE_EMAIL=
TELEGRAM_SUPABASE_PASSWORD=
